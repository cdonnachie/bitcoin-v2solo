# Copy to .env and fill in. .env is ignored by git.

# Automatically retain approximately 20 GB of recent block files.
BITCOIN_PRUNE_MIB=20000

# The pool's SV2 authority keys, created once with
#   docker compose --profile tools run --rm -T sv2-keygen > /opt/secrets/pool.env
# Keep it outside the repository (chmod 600) and back it up.
POOL_ENV_FILE=/opt/secrets/pool.env

# Pool address: receives the reward for workers whose username has no valid payout
# address, and the pool's share of sri/donate usernames. Workers named
# "<address>.<worker>" are paid to their own address (README "Who gets paid").
POOL_PAYOUT_ADDRESS=replace-with-your-mainnet-bitcoin-address

# Text in the coinbase of every block this pool builds (keep it short).
POOL_SIGNATURE=SV2 Solo

# Address the pool (3333) listens on: the host's IP that miners reach, or 0.0.0.0.
# A bind address only picks the interface; use a firewall to limit who connects.
POOL_BIND_ADDRESS=192.168.1.10

# Address the dashboard (8080) listens on. It has no login of its own: keep it on a
# private network or VPN, or behind a reverse proxy with authentication.
DASHBOARD_BIND_ADDRESS=192.168.1.10

# Comma-separated miner (AxeOS) IP addresses the dashboard can reach, for temperature,
# error rate and clock settings. Leave empty if the dashboard cannot reach the miners.
DASHBOARD_BITAXE_HOSTS=

# Currency for valuing the block reward: USD, EUR, GBP, CAD, CHF, AUD or JPY.
DASHBOARD_FIAT=USD

# testnet4 trial (compose.testnet4.yaml): a tb1 address for the test payout.
TESTNET4_PAYOUT_ADDRESS=

# regtest smoke test (compose.regtest.yaml): a bcrt1 address from the regtest node wallet.
REGTEST_PAYOUT_ADDRESS=
