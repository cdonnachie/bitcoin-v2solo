# Node data lives in the `bitcoin-v2solo-data` Docker volume; see README "Node data location".
# Automatically retain approximately 20 GB of recent block files.
BITCOIN_PRUNE_MIB=20000

# Generated by `docker compose --profile tools run --rm sv2-keygen` and saved outside the repository.
POOL_ENV_FILE=G:/bitcoin-v2solo/secrets/pool.env

# Bitcoin address that receives the full coinbase reward if either Bitaxe omits its address.
POOL_PAYOUT_ADDRESS=replace-with-your-mainnet-bitcoin-address

# This PC's private-LAN address. Binding chooses the listening interface only;
# the Windows Firewall rule in the README limits which clients may connect.
POOL_BIND_ADDRESS=10.0.0.185

# Comma-separated Bitaxe LAN IP addresses for the private monitoring dashboard.
DASHBOARD_BITAXE_HOSTS=
DASHBOARD_BIND_ADDRESS=10.0.0.185
# Currency for valuing the block reward: USD, EUR, GBP, CAD, CHF, AUD or JPY.
DASHBOARD_FIAT=USD
# testnet4 trial (compose.testnet4.yaml): a tb1 address for the test payout.
TESTNET4_PAYOUT_ADDRESS=
# regtest smoke test (compose.regtest.yaml): a bcrt1 address from the regtest node wallet.
REGTEST_PAYOUT_ADDRESS=
